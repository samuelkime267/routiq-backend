PORT=2607
NODE_ENV="development"
MONGO_URL = ""
JWT_SECRET = "overlysecretsomething"
HASH_SECRET= "overlyhashsecret"
ADMIN_EMAIL = ""
ADMIN_PASSWORD = ""
ADMIN_ROLE = "SUPER_ADMIN"
JWT_ACCESS_EXPIRES_IN = "5m"
JWT_REFRESH_EXPIRES_IN = "30d"
GOOGLE_CLIENT_ID =  ""
GOOGLE_CLIENT_SECRET = ""

# Email (Nodemailer)
# Either set SMTP_SERVICE for a known provider (e.g. gmail, outlook365, zoho)
# and leave SMTP_HOST blank, or leave SMTP_SERVICE blank and use SMTP_HOST.
# Gmail requires an App Password, not your normal account password.
SMTP_SERVICE = ""
SMTP_HOST = ""
SMTP_PORT = 587
SMTP_SECURE = false
SMTP_USER = ""
SMTP_PASS = ""
SMTP_FROM_NAME = "Routiq"
SMTP_FROM_EMAIL = ""

CLOUDINARY_CLOUD_NAME = ""
CLOUDINARY_API_KEY = ""
CLOUDINARY_API_SECRET = ""
CLOUDINARY_FOLDER = "routiq"

FRONTEND_URL =  "http://localhost:3000"
ADMIN_URL = "http://admin.localhost:3000"
VENDOR_URL = "http://vendor.localhost:3000"

# Public marketplace origin, used for Paystack callback redirects.
MARKETPLACE_URL = "http://localhost:3000"

# Payments (Paystack). Only the secret key is required by the server; checkout
# always uses Paystack's hosted page, so the public key is display-only.
# Test keys start with sk_test_/pk_test_. PAYSTACK_WEBHOOK_SECRET defaults to
# PAYSTACK_SECRET_KEY. Point the Paystack dashboard webhook at
# <backend>/api/v1/payments/webhook.
PAYSTACK_SECRET_KEY = ""
PAYSTACK_PUBLIC_KEY = ""
PAYSTACK_BASE_URL = "https://api.paystack.co"
PAYSTACK_WEBHOOK_SECRET = ""

# Delivery (Shipbubble). When unset, checkout falls back to the platform
# shipping settings in PlatformSetting and labels the quote accordingly.
SHIPBUBBLE_API_KEY = ""
SHIPBUBBLE_BASE_URL = "https://api.shipbubble.com/v1"
# Shipbubble requires an email on address validation; address book entries do
# not store one, so this is used as the fallback contact.
SHIPBUBBLE_CONTACT_EMAIL = "support@routiq.ng"
# Development only. When true (and NODE_ENV is not production), a configured but
# failing Shipbubble account falls back to the platform delivery rate so local
# checkout and payment testing can continue. Never honoured in production.
DELIVERY_PLATFORM_FALLBACK = "false"
# Optional: pin the Shipbubble package category used for rate requests. When
# empty, the account's category list is fetched and a default is chosen.
SHIPBUBBLE_CATEGORY_ID = ""
